# PostgreSQL connection string (Neon, Supabase, local Postgres, ...)
DATABASE_URL="postgresql://user:password@host:5432/attendify?sslmode=require"

# Secret used to sign login sessions (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="change-me"

# Shared secret the ESP32 sends in the x-device-key header
DEVICE_API_KEY="change-me-too"

# Timezone of the institution; schedule times are interpreted here (Vercel servers run in UTC)
APP_TIMEZONE="Asia/Kolkata"

# Gmail account + App Password used to send attendance reports (optional)
EMAIL_USER="you@gmail.com"
EMAIL_PASS="gmail-app-password"

# Demo accounts are offered automatically once seeded (`npm run db:seed`); set to "false" to hide them
DEMO_MODE="true"
