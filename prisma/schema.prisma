generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Teacher {
  id        String   @id @default(uuid())
  name      String
  teacherId String   @unique
  email     String   @unique
  phone     String
  password  String
  createdAt DateTime @default(now())

  schedules Schedule[]
}

model Student {
  id         String   @id @default(uuid())
  name       String
  rollNumber String
  email      String   @unique
  phone      String
  password   String
  createdAt  DateTime @default(now())

  classId String
  class   Class  @relation(fields: [classId], references: [id])

  device     Device?
  attendance Attendance[]

  @@unique([classId, rollNumber])
}

/// A student's registered phone. The ESP32 reports MAC addresses it sees;
/// a match here identifies the student. Stored normalized as AA:BB:CC:DD:EE:FF.
model Device {
  id         String  @id @default(uuid())
  macAddress String  @unique
  deviceName String?

  studentId String  @unique
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Class {
  id        String @id @default(uuid())
  className String
  section   String

  students  Student[]
  schedules Schedule[]

  @@unique([className, section])
}

model Subject {
  id          String @id @default(uuid())
  subjectName String
  subjectCode String @unique

  schedules Schedule[]
}

/// A weekly recurring lecture slot. Times are wall-clock "HH:mm" strings in
/// APP_TIMEZONE, so they compare lexicographically and survive server TZ changes.
model Schedule {
  id        String   @id @default(uuid())
  dayOfWeek String // MONDAY..SUNDAY
  startTime String // "HH:mm"
  endTime   String // "HH:mm"
  createdAt DateTime @default(now())

  teacherId String
  classId   String
  subjectId String

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  attendance Attendance[]
  sessions   AttendanceSession[]

  @@index([classId, dayOfWeek])
  @@index([teacherId])
}

/// One row per student per lecture occurrence. Missing rows for a finished
/// occurrence are reported as Absent, so absences never need a background job.
model Attendance {
  id        String   @id @default(uuid())
  date      DateTime @db.Date // calendar date of the lecture in APP_TIMEZONE
  status    String // "Present" | "Absent"
  source    String   @default("WIFI") // "WIFI" | "MANUAL"
  timestamp DateTime @default(now())

  studentId  String
  scheduleId String

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([studentId, scheduleId, date])
  @@index([scheduleId, date])
}

/// A teacher-started attendance window. While active, the ESP32's scans count
/// for this schedule even outside its regular time slot (extra/rescheduled class).
model AttendanceSession {
  id        String    @id @default(uuid())
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  endedAt   DateTime?

  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([isActive, expiresAt])
}
